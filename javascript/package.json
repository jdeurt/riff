{
  "name": "riff-fixtures",
  "version": "0.1.0",
  "description": "Schema-guided fuzz fixtures for API tests",
  "repository": {
    "type": "git",
    "url": "https://github.com/jdeurt/riff.git",
    "directory": "javascript"
  },
  "bin": {
    "riff": "dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "native/index.node",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "build": "cargo build --locked --release -p riff-neon && tsgo -p tsconfig.build.json && node dist/scripts/install-native.js",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "@standard-schema/spec": "^1.1.0",
    "lossless-json": "^4.3.3",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006"
  },
  "engines": {
    "node": ">=22.12"
  }
}
